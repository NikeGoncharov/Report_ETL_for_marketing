[Unit]
Description=Report Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user/Report/backend
Environment="PATH=/home/user/venv/bin"
ExecStart=/home/user/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/var/log/report/backend.log
StandardError=append:/var/log/report/backend-error.log

[Install]
WantedBy=multi-user.target
