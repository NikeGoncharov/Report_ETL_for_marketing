# ============================================================
# RePort — шаблон .env для домашнего деплоя (docker compose).
# Скопируй в .env рядом с compose.yaml и заполни РЕАЛЬНЫМИ значениями.
# Файл .env в git НЕ попадает (.gitignore). Полный разбор — runbook §4.
# ============================================================

# --- Режим ---
ENVIRONMENT=production          # включает IS_PRODUCTION и guard на дефолтный SECRET_KEY
COOKIE_SECURE=true              # иначе session/refresh-cookie без флага Secure

# --- Публичный адрес (OAuth success-redirect + CORS origin) ---
FRONTEND_URL=https://report-analytics.ru

# --- OAuth redirect URIs: https + префикс /api (совпадают с кабинетами Яндекс/Google) ---
YANDEX_REDIRECT_URI=https://report-analytics.ru/api/integrations/yandex/callback
GOOGLE_REDIRECT_URI=https://report-analytics.ru/api/integrations/google/callback

# --- SECRET_KEY: сгенерируй свой и держи ПОСТОЯННЫМ ---
# Подписывает JWT и HMAC OAuth-state. Сгенерировать: openssl rand -hex 32
# Менять на работающем проде без нужды НЕЛЬЗЯ — смена инвалидирует все сессии и
# in-flight OAuth (юзерам заново входить и переподключать интеграции).
SECRET_KEY=

# --- OAuth-креды (перенести с ВМ как есть) ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Пользователи приложения ---
# ВНИМАНИЕ: APP_LOGIN/APP_PASSWORD приложение НЕ читает — задавать их здесь бесполезно.
# Пользователи создаются админ-командой внутри контейнера (см. backend/manage.py):
#   docker compose exec report-backend python manage.py set-password <email> '<пароль>'
# set-password создаёт пользователя, если его ещё нет, и обходит ALLOWED_REGISTRATION_EMAILS.

# --- Cloudflare Tunnel (токен из Zero Trust dashboard) ---
TUNNEL_TOKEN=

# --- НЕ задавать DATABASE_URL / DATABASE_URL_SYNC! ---
# Путь к БД (/app/data/data.db на смонтированном томе) задаёт сам образ.
# Абсолютный путь ВМ (sqlite:////home/user/...) здесь увёл бы БД мимо тома и расщепил данные.
