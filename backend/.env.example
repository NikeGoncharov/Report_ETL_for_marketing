# Database (default: SQLite in backend/data/)
# DATABASE_URL=sqlite+aiosqlite:///data/data.db
# DATABASE_URL_SYNC=sqlite:///data/data.db

# JWT
# SECRET_KEY=your-secret-key-change-in-production

# Production
# ENVIRONMENT=production
# COOKIE_SECURE=true

# Frontend URL — куда редиректить после OAuth (для продакшена: https://report-analytics.ru)
FRONTEND_URL=http://localhost:3000

# ========== OAuth: подключение источников (Яндекс.Директ, Метрика, Google Sheets) ==========
# Без этих переменных кнопка «Подключить» вернёт ошибку «Yandex/Google OAuth not configured».

# Яндекс OAuth: https://oauth.yandex.ru/ — создать приложение, права: Директ API и/или Метрика (чтение).
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Redirect URI должен совпадать с тем, что указан в настройках приложения (Платформы → Веб-сервисы).
# Локально: http://localhost:8000/integrations/yandex/callback
# Продакшен (если API под /api): https://report-analytics.ru/api/integrations/yandex/callback
YANDEX_REDIRECT_URI=http://localhost:8000/integrations/yandex/callback

# Google OAuth: Google Cloud Console — создать OAuth 2.0 Client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Аналогично: в «Authorized redirect URIs» добавить тот же URL, что и здесь.
# Продакшен: https://report-analytics.ru/api/integrations/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback

# Регистрация (опционально): только указанные email смогут регистрироваться.
# ALLOWED_REGISTRATION_EMAILS=user@example.com,other@example.com
